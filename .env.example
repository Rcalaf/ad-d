# Chat model provider: ollama | openai_compatible | anthropic
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:7b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.7

# Embedding model for the rules search (always local, through Ollama)
EMBEDDING_MODEL=bge-m3

# Language of the agents' output: es | ca | en
GAME_LANGUAGE=es